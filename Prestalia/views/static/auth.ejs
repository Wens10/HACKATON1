<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Connexion & Inscription</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <%- include("/default-header") %>
  <main>
    <div class="auth-container">
      <div id="login"></div>
      <div id="signup"></div>
      <div id="login-form" class="form-content">
        <form action="/api/login" method="post">
          <div class="form-group">
            <label for="email">Email</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" placeholder="votre@email.com" name="email" required>
            </div>
          </div>
          <div class="form-group">
            <label for="password">Mot de passe</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-lock"></i>
              <input type="password" placeholder="••••••••" name="password" required>
            </div>
          </div>
          <a href="#" class="forgot-pass">Mot de passe oublié ?</a>
          <button type="submit" class="btn-submit">Se connecter</button>
        </form>
      </div>
      <div id="signup-form" class="form-content">
        <form action="/api/signup" method="post">
          <div class="form-group">
            <label for="name">Nom complet</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-user"></i>
              <input type="text" placeholder="Jean Dupont" name="name" required>
            </div>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" placeholder="votre@email.com" name="email" required maxlength="320">
            </div>
          </div>
          <div class="form-group">
            <label for="password">Mot de passe</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-lock"></i>
              <input type="password" placeholder="Créer un mot de passe" name="password" required>
            </div>
          </div>
          <button type="submit" class="btn-submit">Créer mon compte</button>
          <p class="terms">En vous inscrivant, vous acceptez nos conditions d'utilisation.</p>
        </form>
      </div>
      <div id="tabs">
        <a href="#login" class="tab">Connexion</a>
        <a href="#signup" class="tab">Inscription</a>
      </div>
    </div>
  </main>
  <%- include("/footer") %>
</body>
</html>