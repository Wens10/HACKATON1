<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Inscription Prestataire</title>
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/presta-inscription.css">
</head>
<body>
  <%- include("/default-header") %>
  <div class="container">
    <div class="header">
      <h1>Devenir prestataire</h1>
      <p>Rejoignez notre communauté de professionnels</p>
    </div>
    <div class="stepper">
      <div class="step active" id="s1">
        <div class="step-circle">1</div>
        <div class="step-label">Infos</div>
      </div>
      <div class="step" id="s2">
        <div class="step-circle">2</div>
        <div class="step-label">Activité</div>
      </div>
      <div class="step" id="s3">
        <div class="step-circle">3</div>
        <div class="step-label">Dispos</div>
      </div>
      <div class="step" id="s4">
        <div class="step-circle">4</div>
        <div class="step-label">Validation</div>
      </div>
    </div>
    <div class="card">
      <form id="regForm">
        <div class="form-section active">
          <h2>Informations personnelles</h2>
          <div class="grid">
            <div class="form-group full-width">
              <label>Nom complet *</label>
              <input type="text" id="nom" placeholder="Ex: Jean Dupont">
            </div>
            <div class="form-group">
              <label>Email *</label>
              <input type="email" id="email" placeholder="email@exemple.com">
            </div>
            <div class="form-group">
              <label>Téléphone *</label>
              <input type="tel" id="tel" placeholder="06 00 00 00 00">
            </div>
            <div class="form-group full-width">
              <label>Ville *</label>
              <input type="text" id="ville" placeholder="Ex: Paris (75)">
            </div>
          </div>
        </div>
        <div class="form-section">
          <h2>Activité professionnelle</h2>
          <div class="form-group">
            <label>Catégorie principale *</label>
            <select id="cat">
              <option value="">Choisir...</option>
              <option>Électricité</option>
              <option>Plomberie</option>
              <option>Peinture</option>
            </select>
          </div>
          <div class="form-group">
            <label>Description *</label>
            <textarea id="desc" rows="4" placeholder="Décrivez votre expérience..."></textarea>
          </div>
          <div class="grid">
            <div class="form-group">
              <label>Expérience (ans) *</label>
              <input type="number" id="exp">
            </div>
            <div class="form-group">
              <label>Tarif horaire (€) *</label>
              <input type="number" id="tarif">
            </div>
          </div>
        </div>
        <div class="form-section">
          <h2>Disponibilités</h2>
          <label>Jours de disponibilité *</label>
          <div class="days-grid">
            <div class="day-btn">
              <label for="lundi">Lundi</label>
              <input type="checkbox" name="lundi" id="lundi">
            </div>
            <div class="day-btn">
              <label for="mardi">Mardi</label>
              <input type="checkbox" name="mardi" id="mardi">
            </div>
            <div class="day-btn">
              <label for="mercredi">Mercredi</label>
              <input type="checkbox" name="mercredi" id="mercredi">
            </div>
            <div class="day-btn">
              <label for="jeudi">Jeudi</label>
              <input type="checkbox" name="jeudi" id="jeudi">
            </div>
            <div class="day-btn">
              <label for="vendredi">Vendredi</label>
              <input type="checkbox" name="vendredi" id="vendredi">
            </div>
            <div class="day-btn">
              <label for="samedi">Samedi</label>
              <input type="checkbox" name="samedi" id="samedi">
            </div>
            <div class="day-btn">
              <label for="dimanche">Dimanche</label>
              <input type="checkbox" name="dimanche" id="dimanche">
            </div>
          </div>
        </div>
        <div class="form-section">
          <h2>Validation et documents</h2>
          <div class="form-group">
            <label>Uploader vos diplômes/certificats</label>
            <div class="upload-zone" id="dropzone">
              <p>Glissez vos fichiers ou <strong>cliquez ici</strong></p>
              <input type="file" id="fileInput" multiple style="display:none">
              <div class="file-list" id="fileList"></div>
            </div>
          </div>
          <div class="summary-box">
            <div id="summaryContent" style="font-size: 14px; line-height: 1.6;"></div>
          </div>
          <div class="warning-box">
            <span>⚠️</span>
            <div>Étude de votre dossier sous 48h. Un email vous sera envoyé après validation.</div>
          </div>
        </div>
        <div class="footer-btns">
          <button type="button" class="btn btn-prev hidden" id="btnPrev">Précédent</button>
          <button type="button" class="btn btn-next" id="btnNext">Suivant</button>
        </div>
      </form>
    </div>
  </div>
  <%- include("/footer") %>
  <script>
    let currentStep = 0;

    const sections = document.querySelectorAll(".form-section"),
      steps = document.querySelectorAll(".step"),
      btnNext = document.getElementById("btnNext"),
      btnPrev = document.getElementById("btnPrev");

    function showStep(n) {
      sections.forEach((s, i) => s.classList.toggle("active", i === n));
      steps.forEach((s, i) => {
        s.classList.toggle("active", i === n);
        s.classList.toggle("completed", i < n);
        s.querySelector(".step-circle").innerHTML = i < n ? "✓" : (i + 1);
      });

      btnPrev.classList.toggle("hidden", n === 0);
      btnNext.innerHTML = (n === sections.length - 1) ? "Finaliser" : "Suivant";

      if (n === 3) updateSummary();
    }

    btnNext.addEventListener("click", () => {
      if (currentStep < sections.length - 1) showStep(++currentStep);
      else alert("Formulaire envoyé !");
    });

    btnPrev.addEventListener("click", () => {
      if (currentStep > 0) showStep(--currentStep);
    });

    // Upload de fichiers
    const fileInput = document.getElementById("fileInput");
    
    document.getElementById("dropzone").addEventListener("click", fileInput.click);

    fileInput.addEventListener("change", () => {
      const list = document.getElementById("fileList");

      list.innerHTML = "";

      Array.from(fileInput.files).forEach(f => list.innerHTML += `<span class="file-badge">${f.name}</span>`);
    });

    function updateSummary() {
      document.getElementById("summaryContent").innerHTML = `
        <strong>Récapitulatif :</strong><br>
        Nom : ${document.getElementById("nom").value || "-"}<br>
        Métier : ${document.getElementById("cat").value || "-"}<br>
        Ville : ${document.getElementById("ville").value || "-"}
      `;
    }
  </script>
</body>
</html>