<header>
  <div class="pnav-inner">
    <a href="/" class="pnav-logo">
      <img src="/photos/Gemini_Generated_Image_3be0lc3be0lc3be0-removebg-preview.png" alt="Logo Prestalia" width="52" height="52">
    </a>
    <ul class="pnav-links">
      <li><a href="/">Accueil</a></li>
      <li><a href="/recherche">Rechercher</a></li>
      <li><a href="/tableau">Mes réservations</a></li>
      <% if (user.role === "provider") { %>
        <li><a href="/tableau_presta">Tableau de bord</a></li>
      <% } %>
    </ul>
    <div class="pnav-actions">
      <a href="/profile/@me" class="btn-bg1">Profil</a>
    </div>
    <button class="pnav-burger" id="burgerBtn" aria-label="Ouvrir le menu">
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
    </button>
  </div>

  <div class="drawer-overlay" id="drawerOverlay"></div>
  <aside class="pnav-drawer" id="navDrawer">
    <button class="drawer-close" id="drawerClose">✕</button>
    <nav class="drawer-links">
      <a href="/">Accueil</a>
      <a href="/recherche">Rechercher</a>
      <a href="/tableau">Mes réservations</a>
      <% if (user.role === "provider") { %>
        <a href="/tableau_presta">Tableau de bord</a>
      <% } %>
    </nav>
    <div class="drawer-cta">
      <a href="/profile/@me" class="btn-bg1">Profil</a>
    </div>
  </aside>
</header>
<script>
(function(){
  var b=document.getElementById('burgerBtn'),o=document.getElementById('drawerOverlay'),d=document.getElementById('navDrawer'),c=document.getElementById('drawerClose'),bars=b.querySelectorAll('.burger-bar');
  function open(){d.classList.add('open');o.classList.add('open');bars[0].style.transform='translateY(7px) rotate(45deg)';bars[1].style.opacity='0';bars[2].style.transform='translateY(-7px) rotate(-45deg)';document.body.style.overflow='hidden';}
  function close(){d.classList.remove('open');o.classList.remove('open');bars[0].style.transform='';bars[1].style.opacity='';bars[2].style.transform='';document.body.style.overflow='';}
  b.addEventListener('click',open);c.addEventListener('click',close);o.addEventListener('click',close);

  var path=window.location.pathname;
  document.querySelectorAll('.pnav-links a, .drawer-links a').forEach(function(a){
    var href=a.getAttribute('href');
    var active=href==='/'?path==='/':path===href||path.startsWith(href+'/');
    if(active)a.classList.add('active');
  });
})();
</script>