<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Profil - Jean Dupont</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <style>
    :root {
      --primary: #2563eb;
      --bg-gray: #f8fafc;
      --border: #e2e8f0;
      --text-main: #1e293b;
      --text-light: #64748b;
      --green: #22c55e;
    }

    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: var(--bg-gray);
      color: var(--text-main);
      margin: 0;
    }

    main {
      padding: 20px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    /* --- En-tête du profil --- */
    .profile-header {
      background: white;
      padding: 30px;
      border-radius: 15px;
      border: 1px solid var(--border);
      display: flex;
      align-items: flex-start;
      gap: 25px;
      margin-bottom: 25px;
      position: relative;
    }

    .avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      background: #eee;
    }

    .header-info h1 {
      margin: 0;
      font-size: 28px;
    }

    .category {
      color: var(--text-light);
      margin: 5px 0;
    }

    .stats {
      font-size: 14px;
      margin: 10px 0;
    }

    .star {
      color: #fbbf24;
      margin-right: 4px;
    }

    .tags {
      display: flex;
      gap: 8px;
      margin: 15px 0;
    }

    .tag {
      background: #eff6ff;
      color: var(--primary);
      padding: 4px 12px;
      border-radius: 15px;
      font-size: 12px;
    }

    .verified-badge {
      position: absolute;
      top: 25px;
      right: 25px;
      color: var(--green);
      font-size: 12px;
      border: 1px solid #dcfce7;
      padding: 4px 10px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .header-actions {
      display: flex;
      gap: 12px;
    }

    .btn {
      padding: 10px 25px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid var(--primary);
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-outline {
      background: white;
      color: var(--primary);
    }

    /* --- Layout Grid --- */
    .profile-content {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 25px;
    }

    /* --- Blocs de Gauche --- */
    section {
      background: white;
      padding: 25px;
      border-radius: 15px;
      border: 1px solid var(--border);
      margin-bottom: 25px;
    }

    section h2 {
      margin-top: 0;
      font-size: 20px;
      border-bottom: 1px solid transparent;
    }

    .galerie-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .galerie-grid img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 10px;
    }

    .review {
      border-bottom: 1px solid var(--border);
      padding: 15px 0;
      position: relative;
    }

    .review:last-child {
      border-bottom: none;
    }

    .review-date {
      position: absolute;
      right: 0;
      top: 15px;
      font-size: 12px;
      color: var(--text-light);
    }

    /* --- Sidebar Droite --- */
    .sidebar-card {
      background: white;
      padding: 20px;
      border-radius: 15px;
      border: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .price-big {
      font-size: 24px;
      font-weight: bold;
    }

    .sidebar-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .sidebar-list li {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-size: 14px;
    }

    .status-available {
      color: var(--green);
      font-weight: 600;
    }

    .status-busy {
      color: #cbd5e1;
    }

    .contact-link {
      display: block;
      color: var(--primary);
      text-decoration: none;
      margin-top: 10px;
      font-size: 14px;
    }

    @media (max-width: 850px) {
      .profile-content {
        grid-template-columns: 1fr;
      }

      .profile-header {
        flex-direction: column;
        text-align: center;
        align-items: center;
      }

      .header-actions {
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <%- include("/header") %>
  <main>
    <div class="container">
      <div class="profile-header">
        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Jean" alt="Avatar" class="avatar">
        <div class="header-info">
          <h1>Jean Dupont</h1>
          <p class="category">Plomberie</p>
          <div class="stats">
            <span class="star">★</span> <strong>4.8</strong> <span style="color:var(--text-light)">(124 avis)</span>
            <span style="margin-left: 15px; color:var(--text-light)"><i class="fa-solid fa-location-dot"></i>Paris</span>
          </div>
          <div class="tags">
            <span class="tag">Dépannage</span>
            <span class="tag">Installation</span>
            <span class="tag">Rénovation</span>
          </div>
          <div class="header-actions">
            <button class="btn btn-primary"><i class="fa-solid fa-phone"></i> Contacter</button>
            <button class="btn btn-outline"><i class="fa-regular fa-calendar"></i> Réserver</button>
          </div>
        </div>
        <div class="verified-badge">
          <i class="fa-solid fa-circle-check"></i> Vérifié
        </div>
      </div>
      <div class="profile-content">
        <div class="main-column">
          <section>
            <h2>À propos</h2>
            <p style="color: var(--text-light); line-height: 1.6;">
              Plombier professionnel avec plus de 15 ans d'expérience. Intervention rapide et garantie sur tous les travaux.
            </p>
          </section>
          <section>
            <h2>Galerie</h2>
            <div class="galerie-grid">
              <img src="https://images.unsplash.com/photo-1581244276892-ecfb6122044c?q=80&w=600" alt="Travail 1">
              <img src="https://images.unsplash.com/photo-1504148455328-c376907d081c?q=80&w=600" alt="Travail 2">
            </div>
          </section>
          <section>
            <h2>Avis clients</h2>
            <div class="review">
              <strong>Client 1</strong>
              <div class="star">★★★★☆</div>
              <p style="font-size: 14px;">Excellent service, très professionnel et ponctuel. Je recommande vivement !</p>
              <span class="review-date">Il y a 1 jour</span>
            </div>
            <div class="review">
              <strong>Client 2</strong>
              <div class="star">★★★★☆</div>
              <p style="font-size: 14px;">Excellent service, très professionnel et ponctuel. Je recommande vivement !</p>
              <span class="review-date">Il y a 2 jours</span>
            </div>
          </section>
        </div>
        <div class="sidebar">
          <div class="sidebar-card">
            <div style="font-size: 14px; color: var(--text-light);">Tarification</div>
            <div class="price-big">45€<span style="font-size: 16px; font-weight: normal; color: var(--text-light);">/heure</span>
            </div>
            <div style="font-size: 12px; color: var(--text-light);">Tarif indicatif</div>
          </div>
          <div class="sidebar-card">
            <h3 style="font-size: 16px; margin-top: 0;">Informations</h3>
            <ul class="sidebar-list" style="color: var(--text-light);">
              <li><span><i class="fa-regular fa-clock"></i> Temps de réponse</span> <span>&lt; 1h</span></li>
              <li><span><i class="fa-solid fa-briefcase"></i> Expérience</span> <span>15 ans</span></li>
              <li><span><i class="fa-solid fa-check"></i> Prestations réalisées</span> <span>456</span></li>
            </ul>
          </div>
          <div class="sidebar-card">
            <h3 style="font-size: 16px; margin-top: 0;">Disponibilités</h3>
            <ul class="sidebar-list">
              <li>Lundi <span class="status-available">Disponible</span></li>
              <li>Mardi <span class="status-available">Disponible</span></li>
              <li>Mercredi <span class="status-available">Disponible</span></li>
              <li>Samedi <span class="status-busy">Indisponible</span></li>
              <li>Dimanche <span class="status-busy">Indisponible</span></li>
            </ul>
          </div>
          <div class="sidebar-card">
            <h3 style="font-size: 16px; margin-top: 0;">Contact</h3>
            <a href="#" class="contact-link"><i class="fa-solid fa-phone"></i> 06 12 34 56 78</a>
            <a href="#" class="contact-link"><i class="fa-regular fa-envelope"></i> jean.dupont@example.com</a></div>
        </div>
      </div>
    </div>
  </main>
  <%- include("/footer") %>
</body>
</html>