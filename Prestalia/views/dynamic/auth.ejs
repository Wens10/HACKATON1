<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Connexion & Inscription</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/auth.css">
  <style>
    .form-error {
      background: #fdecea;
      color: #c0392b;
      border: 1px solid #e74c3c;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
    }
    .form-success {
      background: #eafaf1;
      color: #1e8449;
      border: 1px solid #27ae60;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <% if (user) { %>
    <%- include("/header") %>
  <% } else { %>
    <%- include("/default-header") %>
  <% } %>
  <main>
    <div class="auth-container">
      <div id="login"></div>
      <div id="signup"></div>
      <div id="login-form" class="form-content">
        <div id="reset-success"></div>
        <div id="login-error"></div>
        <form id="form-login" action="/api/login<%= to ? '?to=' + to : '' %>" method="post">
          <div class="form-group">
            <label for="email">Email</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" placeholder="votre@email.com" name="email" required>
            </div>
          </div>
          <div class="form-group">
            <label for="password">Mot de passe</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-lock"></i>
              <input type="password" placeholder="••••••••" name="password" required>
            </div>
          </div>
          <a href="/mot-de-passe-oublie" class="forgot-pass">Mot de passe oublié ?</a>
          <button type="submit" class="btn-submit">Se connecter</button>
        </form>
      </div>
      <div id="signup-form" class="form-content">
        <div id="signup-error"></div>
        <form id="form-signup" action="/api/signup<%= to ? '?to=' + to : '' %>" method="post">
          <div class="form-group">
            <label for="name">Nom complet</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-user"></i>
              <input type="text" placeholder="Jean Dupont" name="name" required>
            </div>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <div class="input-wrapper">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" placeholder="votre@email.com" name="email" required maxlength="320">
            </div>
          </div>
          <div class="form-group">
            <label for="password">Mot de passe</label>
            <div class="input-wrapper">
              <i class="fa-solid fa-lock"></i>
              <input type="password" placeholder="Créer un mot de passe" name="password" required>
            </div>
          </div>
          <button type="submit" class="btn-submit">Créer mon compte</button>
          <p class="terms">En vous inscrivant, vous acceptez nos conditions d'utilisation.</p>
        </form>
      </div>
      <div id="tabs">
        <a href="<%= to ? '?to=' + to : '' %>#login" class="tab">Connexion</a>
        <a href="<%= to ? '?to=' + to : '' %>#signup" class="tab">Inscription</a>
      </div>
    </div>
  </main>
  <%- include("/footer") %>
  <script>
    const errorMessages = {
      login: {
        401: "Email ou mot de passe incorrect.",
        500: "Erreur serveur, veuillez réessayer.",
        default: "Une erreur est survenue."
      },
      signup: {
        409: "Un compte existe déjà avec cet email.",
        400: "Données invalides, vérifiez le formulaire.",
        500: "Erreur serveur, veuillez réessayer.",
        default: "Une erreur est survenue."
      }
    };

    function showError(containerId, message) {
      const container = document.getElementById(containerId);
      container.innerHTML = `
        <div class="form-error">
          <i class="fa-solid fa-circle-exclamation"></i> ${message}
        </div>`;
    }

    function clearError(containerId) {
      document.getElementById(containerId).innerHTML = "";
    }

    async function handleForm(formId, errorContainerId, type) {
      const form = document.getElementById(formId);

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError(errorContainerId);

        const btn = form.querySelector("button[type=submit]");
        btn.disabled = true;
        btn.textContent = "Chargement....";

        const body = new URLSearchParams(new FormData(form));

        try {
          const res = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body.toString(),
            redirect: "manual"
          });

          if (res.ok || res.type === "opaqueredirect" || res.status === 303) {
            // Succès → on suit la redirection manuellement
            window.location.href = form.action.includes("?to=")
              ? decodeURIComponent(form.action.split("?to=")[1])
              : "/";
          } else {
            const msgs = errorMessages[type];
            showError(errorContainerId, msgs[res.status] || msgs.default);
            btn.disabled = false;
            btn.textContent = type === "login" ? "Se connecter" : "Créer mon compte";
          }
        } catch (err) {
          showError(errorContainerId, "Impossible de contacter le serveur.");
          btn.disabled = false;
          btn.textContent = type === "login" ? "Se connecter" : "Créer mon compte";
        }
      });
    }

    handleForm("form-login", "login-error", "login");
    handleForm("form-signup", "signup-error", "signup");

    // Message de succès après réinitialisation du mot de passe
    if (new URLSearchParams(window.location.search).get("success") === "reset") {
      document.getElementById("reset-success").innerHTML = `
        <div class="form-success">
          <i class="fa-solid fa-circle-check"></i>
          Mot de passe réinitialisé avec succès ! Vous pouvez maintenant vous connecter.
        </div>`;
    }
  </script>
</body>
</html>