<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Annuaire Prestataires - CSS Pur</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/recherche.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <%- include("/header") %>
  <main>
    <div class="container">
      <div class="search-bar">
        <div class="search-input-wrapper">
          <input type="text" placeholder="Rechercher un service (ex: plombier, jardinier)...">
        </div>
        <button class="btn-search">Rechercher</button>
      </div>
      <div class="main-layout">
        <aside class="filters-sidebar">
          <h3 style="margin-top: 0;">Filtres</h3>
          <div class="filter-group">
            <label for="">Adresse</label>
            <input type="text" placeholder="Entrez votre adresse">
          </div>
          <div class="filter-group">
            <label>Distance : <span id="KilomètreLabel">80</span>Km</label>
            <input type="range" class="price-slider" min="10" max="500" value="50"
              oninput="document.getElementById('KilomètreLabel').innerText = this.value">
            <div class="price-display">
              <span>10Km</span>
              <span>500Km</span>
            </div>
          </div>
          <div class="filter-group">
            <label>Catégorie</label>
            <div class="checkbox-list">
              <label><input type="checkbox"> Plomberie</label>
              <label><input type="checkbox"> Électricité</label>
              <label><input type="checkbox"> Informatique</label>
            </div>
          </div>
          <div class="filter-group">
            <label>Prix max : <span id="priceLabel">80</span>€/h</label>
            <input type="range" class="price-slider" min="10" max="500" value="80"
              oninput="document.getElementById('priceLabel').innerText = this.value">
            <div class="price-display">
              <span>10€</span>
              <span>500€</span>
            </div>
          </div>
        </aside>
        <div class="cards-grid">
          <a href="/profil" class="card-link">
            <article class="card">
              <div class="card-image">
                <img src="https://images.unsplash.com/photo-1581244276892-ecfb6122044c?auto=format&fit=crop&w=400" alt="Plombier">
                <span class="badge-verified">VÉRIFIÉ</span>
              </div>
              <div class="card-content">
                <h3 class="card-name">Jean Dupont</h3>
                <div class="card-category">Plomberie</div>
                <div style="margin-top: 10px; color: #fbbf24; font-size: 14px;">
                  <i class="fas fa-star"></i> 4.8 <span style="color: #94a3b8">(124)</span>
                </div>
                <div class="card-footer">
                  <span class="price">45€/h</span>
                  <span class="btn-profile">Voir profil →</span>
                </div>
              </div>
            </article>
          </a>
          <a href="/profil" class="card-link">
            <article class="card">
              <div class="card-image">
                <img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=400" alt="Électricien">
                <span class="badge-verified">VÉRIFIÉ</span>
              </div>
              <div class="card-content">
                <h3 class="card-name">Thomas Bernard</h3>
                <div class="card-category">Informatique</div>
                <div style="margin-top: 10px; color: #fbbf24; font-size: 14px;">
                  <i class="fas fa-star"></i> 5.0 <span style="color: #94a3b8">(42)</span>
                </div>
                <div class="card-footer">
                  <span class="price">60€/h</span>
                  <span class="btn-profile">Voir profil →</span>
                </div>
              </div>
            </article>
          </a>
        </div>
      </div>
    </div>
  </main>
  <%- include("/footer") %>
</body>
</html>