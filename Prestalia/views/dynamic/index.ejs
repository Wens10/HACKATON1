<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Document</title>
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <%- include("/header") %>
  <main>
    <section class="blue-gradient-bg" id="product-descr">
      <h1>Trouvez le prestataire idéal pour tous vos besoins</h1>
      <p>Connectez-vous avec des professionnels vérifiés et qualifiés partout en France</p>
      <div id="search-container">
        <input type="text" name="search" id="search" placeholder="Quel service recherchez-vous ?">
        <button>Rechercher</button>
      </div>
    </section>
    <section id="popular-categories" class="grey-bg">
      <h2>Catégories populaires</h2>
      <p>Parcourez nos catégories pour trouver rapidement ce dont vous avez besoin</p>
      <div id="popular">
        <div class="category">
          <svg></svg>
          <p><strong>Esthétique & Beauté</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Bien être & Relaxation</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Services à domicile</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Services technique & dépannage</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Services professionnels & entreprise</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Création & Design</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Mobilité & Services pratiques</strong></p>
        </div>
        <div class="category">
          <svg></svg>
          <p><strong>Evénementiel & loisirs</strong></p>
        </div>
      </div>
    </section>
    <section id="reasons">
      <h2>Pourquoi choisir Prestalia ?</h2>
      <div id="reason-list">
        <div class="reason">
          <img class="svg" src="/svg/verify-button-circle-svgrepo-com.svg" alt="">
          <h3>Prestataires vérifiés</h3>
          <p>Tous nos prestataires sont validés manuellement pour garantir la qualité et la sécurité</p>
        </div>
        <div class="reason">
          <img class="svg" src="/svg/star-svgrepo-com.svg" alt="">
          <h3>Avis certifiés</h3>
          <p>Consultez les avis authentiques de clients pour faire le meilleur choix</p>
        </div>
        <div class="reason">
          <img class="svg" src="/svg/reply-svgrepo-com.svg" alt="">
          <h3>Réponse rapide</h3>
          <p>Obtenez des réponses et devis rapidement de la part des professionnels</p>
        </div>
      </div>
    </section>
    <section id="how-work" class="grey-bg">
      <h2>Comment ça marche ?</h2>
      <div id="steps">
        <div class="step">
          <img class="svg" src="/svg/one-circle-svgrepo-com.svg" alt="">
          <h3>Recherchez</h3>
          <p>Trouvez le service dont vous avez besoin</p>
        </div>
        <div class="step">
          <img class="svg" src="/svg/two-circle-svgrepo-com.svg" alt="">
          <h3>Comparez</h3>
          <p>Consultez les profils et avis des prestataires</p>
        </div>
        <div class="step">
          <img class="svg" src="/svg/three-circle-svgrepo-com.svg" alt="">
          <h3>Contactez</h3>
          <p>Prenez contact avec le prestataire choisi</p>
        </div>
        <div class="step">
          <img class="svg" src="/svg/four-circle-svgrepo-com.svg" alt="">
          <h3>Évaluez</h3>
          <p>Partagez votre expérience avec la communauté</p>
        </div>
      </div>
    </section>
    <section id="pro" class="blue-bg">
      <img class="svg" src="/svg/user-shield-alt-1-svgrepo-com.svg" alt="">
      <h2>Vous êtes un professionnel ?</h2>
      <p>Rejoignez notre communauté de prestataires et développez votre activité</p>
      <a href="/presta-inscription">
        <img class="svg" src="/svg/verify-button-circle-svgrepo-com.svg" alt="">
        Devenir prestataire
      </a>
    </section>
  </main>
  <%- include("/footer") %>
</body>
</html>