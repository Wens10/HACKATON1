<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord Prestataire</title>
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/tableau_presta.css">
</head>
<body>
  <%- include("/header") %>
  <div class="container">
    <header class="header">
      <h1>Tableau de bord Prestataire</h1>
      <p>Bienvenue, <%= user.name %></p>
    </header>
    <div class="stats-grid">
      <div class="card stat-box">
        <div class="stat-content">
          <span>Revenus ce mois</span>
          <h2>2,450€</h2>
          <small class="trend up">↗ +12% vs mois dernier</small>
        </div>
        <div class="icon green">$</div>
      </div>
      <div class="card stat-box">
        <div class="stat-content">
          <span>Prestations</span>
          <h2>18</h2>
          <small>8 cette semaine</small>
        </div>
        <div class="icon blue">📅</div>
      </div>
      <div class="card stat-box">
        <div class="stat-content">
          <span>Note moyenne</span>
          <h2>4.8</h2>
          <small>124 avis</small>
        </div>
        <div class="icon yellow">⭐</div>
      </div>
      <div class="card stat-box">
        <div class="stat-content">
          <span>Taux de réponse</span>
          <h2>95%</h2>
          <small>Excellent</small>
        </div>
        <div class="icon purple">💬</div>
      </div>
    </div>
    <div class="main-layout">
      <div class="content-left">
        <section class="card section-main">
          <div class="section-header">
            <h2>Prochaines interventions</h2>
            <button class="btn-text">Voir tout</button>
          </div>
          <div class="intervention-item">
            <div class="int-header">
              <div>
                <strong>Dépannage plomberie</strong>
                <p class="client-name">Client 1</p>
              </div>
              <span class="badge today">Aujourd'hui</span>
            </div>
            <div class="int-details">
              <span>📅 16/12/2025</span>
              <span>⏰ 11:00</span>
              <span>📍 Paris</span>
            </div>
            <div class="int-actions">
              <button class="btn-blue">Détails</button>
              <button class="btn-outline">Contacter</button>
            </div>
          </div>
          <div class="intervention-item">
            <div class="int-header">
              <div>
                <strong>Dépannage plomberie</strong>
                <p class="client-name">Client 2</p>
              </div>
              <span class="badge future">Dans 2 jours</span>
            </div>
            <div class="int-details">
              <span>📅 17/12/2025</span>
              <span>⏰ 12:00</span>
              <span>📍 Paris</span>
            </div>
            <div class="int-actions">
              <button class="btn-blue">Détails</button>
              <button class="btn-outline">Contacter</button>
            </div>
          </div>
        </section>
        <br>
        <section class="card chart-section">
          <h2>Évolution des revenus</h2>
          <div class="chart-placeholder">
            <div class="bars">📊</div>
            <p>Graphique des performances</p>
          </div>
        </section>
      </div>
      <aside class="content-right">
        <div class="card side-card">
          <h3>Actions rapides</h3>
          <ul class="nav-list">
            <li>Gérer mes services</li>
            <li>Modifier mon profil</li>
            <li>Calendrier</li>
            <li>Messages clients</li>
          </ul>
        </div>
        <br>
        <div class="card side-card">
          <h3>Derniers avis</h3>
          <div class="review-item">
            <span class="stars">⭐⭐⭐⭐⭐</span>
            <p>Excellent travail !</p>
            <small>Il y a 1 jour</small>
          </div>
          <div class="review-item">
            <span class="stars">⭐⭐⭐⭐⭐</span>
            <p>Excellent travail !</p>
            <small>Il y a 2 jours</small>
          </div>
        </div>
        <br>
        <div class="card side-card">
          <h3>Profil complété</h3>
          <div class="progress-container">
            <div class="progress-bar" style="width: 85%;"></div>
          </div>
          <p><small>85% complété</small></p>
          <ul class="check-list">
            <li class="done">Informations de base</li>
            <li class="done">Certifications</li>
            <li>Galerie photos</li>
          </ul>
        </div>
        <br>
        <div class="card tip-card">
          💡 <strong>Astuce du jour</strong>
          <p>Les prestataires qui répondent en moins d'une heure ont 3x plus de chances d'obtenir une réservation.</p>
        </div>
      </aside>
    </div>
  </div>
  <%- include("/footer") %>
</body>
</html>