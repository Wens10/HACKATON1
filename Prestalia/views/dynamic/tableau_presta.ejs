<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Tableau de bord — Prestalia</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/tableau_presta.css">
</head>
<body>
  <%- include("/header") %>

  <!-- ── Bannière ──────────────────────────────────────── -->
  <div class="dashboard-banner">
    <div class="banner-inner">
      <div class="banner-left">
        <div class="banner-avatar">
          <%= user.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() %>
        </div>
        <div class="banner-text">
          <h1>Bonjour, <%= user.name %> 👋</h1>
          <p>Voici un aperçu de votre activité</p>
        </div>
      </div>
      <div class="banner-badge">
        <i class="fa-solid fa-circle-check"></i> Prestataire vérifié
      </div>
    </div>
  </div>

  <div class="container">

    <!-- ── Stats ──────────────────────────────────────── -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon green"><i class="fa-solid fa-euro-sign"></i></div>
        <div>
          <div class="stat-label">Revenus ce mois</div>
          <div class="stat-value"><%= stats && stats['monthly_revenue'] ? Math.round(stats['monthly_revenue']) + '€' : '0€' %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-regular fa-calendar-check"></i></div>
        <div>
          <div class="stat-label">Prestations</div>
          <div class="stat-value"><%= stats ? stats['total'] : 0 %></div>
          <div class="stat-sub"><%= stats ? (stats['upcoming_count'] || 0) : 0 %> à venir</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon yellow"><i class="fa-solid fa-star"></i></div>
        <div>
          <div class="stat-label">Note moyenne</div>
          <div class="stat-value">—</div>
          <div class="stat-sub">Bientôt disponible</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon purple"><i class="fa-regular fa-comment-dots"></i></div>
        <div>
          <div class="stat-label">Taux de réponse</div>
          <div class="stat-value">—</div>
          <div class="stat-sub">Bientôt disponible</div>
        </div>
      </div>
    </div>

    <!-- ── Layout principal ──────────────────────────── -->
    <div class="main-layout">
      <div class="content-left">

        <!-- Interventions -->
        <section class="section-card">
          <div class="section-header">
            <h2><i class="fa-regular fa-calendar" style="margin-right:6px;"></i>Interventions</h2>
          </div>

          <% var upcoming = reservations.filter(function(r){ return new Date(r.date) > new Date() && r.status !== 'rejected'; }); %>
          <% if (upcoming.length === 0) { %>
            <div class="empty-state">
              <i class="fa-regular fa-calendar-xmark"></i>
              Aucune intervention à venir.
            </div>
          <% } else { %>
            <% upcoming.forEach(function(r) {
              var d = new Date(r.date);
              var now = new Date();
              var diffDays = Math.floor((d - now) / 86400000);
              var dateStr = d.toLocaleDateString('fr-FR', {day:'2-digit', month:'2-digit', year:'numeric'});
              var timeStr = d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
              var badgeLabel = diffDays === 0 ? "Aujourd'hui" : diffDays === 1 ? "Demain" : "Dans " + diffDays + " jours";
              var badgeClass = diffDays === 0 ? "today" : "future";
            %>
              <div class="intervention-item" id="res-<%= r.id %>">
                <div class="int-header">
                  <div>
                    <strong><%= r.client_name %></strong>
                    <p class="client-name"><%= r.price %>€ &nbsp;·&nbsp; <%= dateStr %> à <%= timeStr %></p>
                  </div>
                  <span class="badge <%= badgeClass %>"><%= badgeLabel %></span>
                </div>
                <div class="int-actions" style="margin-top:10px;">
                  <% if (r.status === 'pending') { %>
                    <button class="btn-blue" onclick="updateStatus(<%= r.id %>, 'confirmed')">
                      <i class="fa-solid fa-check"></i> Confirmer
                    </button>
                    <button class="btn-outline" onclick="updateStatus(<%= r.id %>, 'rejected')">
                      <i class="fa-solid fa-xmark"></i> Refuser
                    </button>
                  <% } else if (r.status === 'confirmed') { %>
                    <span style="color:#16a34a;font-weight:700;font-size:0.85rem;">
                      <i class="fa-solid fa-circle-check"></i> Confirmé
                    </span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } %>
        </section>

        <!-- Historique -->
        <section class="section-card">
          <div class="section-header">
            <h2><i class="fa-solid fa-clock-rotate-left" style="margin-right:6px;"></i>Historique</h2>
          </div>
          <% var past = reservations.filter(function(r){ return new Date(r.date) <= new Date(); }); %>
          <% if (past.length === 0) { %>
            <div class="empty-state">
              <i class="fa-regular fa-folder-open"></i>
              Aucune prestation passée.
            </div>
          <% } else { %>
            <% past.slice(0, 5).forEach(function(r) {
              var d = new Date(r.date);
              var dateStr = d.toLocaleDateString('fr-FR', {day:'2-digit', month:'2-digit', year:'numeric'});
              var timeStr = d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
            %>
              <div class="reservation-item">
                <div class="res-info">
                  <strong><%= r.client_name %></strong>
                  <small><i class="fa-regular fa-calendar"></i> <%= dateStr %> &nbsp; <i class="fa-regular fa-clock"></i> <%= timeStr %></small>
                </div>
                <span class="status" style="background:#f1f5f9;color:#64748b;font-size:0.72rem;padding:4px 10px;border-radius:20px;font-weight:700;white-space:nowrap;"><%= r.price %>€</span>
              </div>
            <% }) %>
          <% } %>
        </section>

        <!-- Graphique -->
        <section class="section-card">
          <div class="section-header">
            <h2><i class="fa-solid fa-chart-line" style="margin-right:6px;"></i>Évolution des revenus</h2>
          </div>
          <div class="chart-placeholder">
            <i class="fa-solid fa-chart-bar"></i>
            <p>Graphique disponible prochainement</p>
          </div>
        </section>

      </div>

      <!-- ── Sidebar ────────────────────────────────── -->
      <aside class="content-right">

        <!-- Actions rapides -->
        <div class="section-card">
          <div class="section-header" style="margin-bottom:0; padding-bottom:0; border-bottom:none;">
            <h2><i class="fa-solid fa-bolt" style="margin-right:6px;"></i>Actions rapides</h2>
          </div>
          <ul class="nav-list" style="margin-top:1rem;">
            <li>
              <span><i class="fa-solid fa-sliders"></i> Gérer mes services</span>
            </li>
            <li>
              <a href="#"><i class="fa-regular fa-pen-to-square"></i> Modifier mon profil</a>
            </li>
            <li>
              <span><i class="fa-regular fa-calendar"></i> Calendrier</span>
            </li>
            <li>
              <a href="#"><i class="fa-regular fa-comment-dots"></i> Messages clients</a>
            </li>
            <li style="border-bottom:none;">
              <a href="/logout" style="color:#e11d48;">
                <i class="fa-solid fa-right-from-bracket" style="color:#e11d48;"></i> Se déconnecter
              </a>
            </li>
          </ul>
        </div>

        <!-- Derniers avis -->
        <div class="section-card">
          <div class="section-header">
            <h2><i class="fa-solid fa-star" style="margin-right:6px;"></i>Derniers avis</h2>
          </div>
          <div class="review-item">
            <div class="review-stars">★★★★★</div>
            <p>Excellent travail, très professionnel !</p>
            <small>Il y a 1 jour</small>
          </div>
          <div class="review-item">
            <div class="review-stars">★★★★★</div>
            <p>Rapide et efficace, je recommande.</p>
            <small>Il y a 2 jours</small>
          </div>
        </div>

        <!-- Profil complété -->
        <div class="section-card">
          <div class="section-header">
            <h2><i class="fa-solid fa-user-check" style="margin-right:6px;"></i>Profil complété</h2>
          </div>
          <div class="progress-wrap">
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width: 85%;"></div>
            </div>
          </div>
          <span class="progress-label">85% complété</span>
          <ul class="check-list">
            <li class="done">
              <span class="check-icon"><i class="fa-solid fa-circle-check"></i></span>
              Informations de base
            </li>
            <li class="done">
              <span class="check-icon"><i class="fa-solid fa-circle-check"></i></span>
              Certifications
            </li>
            <li>
              <span class="check-icon"><i class="fa-regular fa-circle"></i></span>
              Galerie photos
            </li>
          </ul>
        </div>

        <!-- Astuce -->
        <div class="tip-card">
          <div class="tip-header">
            <i class="fa-solid fa-lightbulb"></i> Astuce du jour
          </div>
          <p>Les prestataires qui répondent en moins d'une heure ont 3× plus de chances d'obtenir une réservation.</p>
        </div>

      </aside>
    </div>
  </div>

  <%- include("/footer") %>
  <script>
  function updateStatus(id, status) {
    fetch('/api/reservations/' + id, {
      method: 'PATCH',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'status=' + status
    }).then(function(res) {
      if (res.ok) window.location.reload();
    }).catch(function() {
      alert('Erreur lors de la mise à jour. Veuillez réessayer.');
    });
  }
  </script>
</body>
</html>
