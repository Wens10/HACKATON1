<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord Administrateur</title>
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/tableau_admin.css">
</head>
<body>
  <%- include("/header") %>
  <div class="container">
    <div class="title">
      <h1>Tableau de bord Administrateur</h1>
      <p>Gestion de la plateforme Prestalia</p>
    </div>
    <div class="stats-grid">
      <div class="card stat-card">
        <div>
          <p>Total prestataires</p>
          <h2>6</h2><small>Tous statuts</small>
        </div>
        <div class="icon-circle blue">👥</div>
      </div>
      <div class="card stat-card">
        <div>
          <p>En attente</p>
          <h2>1</h2><small class="text-warning">Action requise</small>
        </div>
        <div class="icon-circle orange">🕒</div>
      </div>
      <div class="card stat-card">
        <div>
          <p>Approuvés</p>
          <h2>5</h2><small>Actifs</small>
        </div>
        <div class="icon-circle green">✅</div>
      </div>
      <div class="card stat-card">
        <div>
          <p>Rejetés</p>
          <h2>0</h2><small>Refusés</small>
        </div>
        <div class="icon-circle red">❌</div>
      </div>
    </div>
    <section class="card table-section">
      <div class="table-header">
        <h2>Gestion des prestataires</h2>
        <div class="filter-group">
          <button class="filter-btn active">Tous</button>
          <button class="filter-btn">En attente (1)</button>
          <button class="filter-btn">Approuvés</button>
          <button class="filter-btn">Rejetés</button>
        </div>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Prestataire</th>
            <th>Catégorie</th>
            <th>Ville</th>
            <th>Note</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="user-cell">
              <div class="avatar">👨‍🔧</div>
              <div><strong>Jean Dupont</strong><br><small>jean.dupont@example.com</small></div>
            </td>
            <td>Plomberie</td>
            <td>Paris</td>
            <td>4.8 <span class="text-light">(124)</span></td>
            <td><span class="badge badge-success">Approuvé</span></td>
            <td><button class="btn-details">Détails</button></td>
          </tr>
          <tr>
            <td class="user-cell">
              <div class="avatar">👩‍💻</div>
              <div><strong>Lucas Petit</strong><br><small>lucas.petit@example.com</small></div>
            </td>
            <td>Menuiserie</td>
            <td>Bordeaux</td>
            <td>4.9 <span class="text-light">(78)</span></td>
            <td><span class="badge badge-warning">En attente</span></td>
            <td class="action-cell">
              <button class="btn-approve">Approuver</button>
              <button class="btn-reject">Rejeter</button>
              <button class="btn-details">Détails</button>
            </td>
          </tr>
        </tbody>
      </table>
    </section>
    <div class="bottom-grid">
      <div class="card">
        <h3>Activité récente</h3>
        <ul class="activity-list">
          <li><span class="dot green"></span> Nouveau prestataire inscrit <br><small>Il y a 2 heures</small>
          </li>
          <li><span class="dot blue"></span> Prestataire approuvé <br><small>Il y a 5 heures</small></li>
        </ul>
      </div>
      <div class="card">
        <h3>Catégories populaires</h3>
        <div class="cat-item"><span>Plomberie</span> <span class="count">5</span></div>
        <div class="cat-item"><span>Électricité</span> <span class="count">3</span></div>
      </div>
      <div class="card warning-card">
        <h3>⚠️ Attention</h3>
        <p>1 prestataire en attente de validation</p>
      </div>
    </div>
  </div>
  <%- include("/footer") %>
</body>
</html>