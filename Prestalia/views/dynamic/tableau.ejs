<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/photos/Gemini_Generated_Image.png" type="image/png">
  <title>Mon tableau de bord — Prestalia</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/tableau.css">
</head>
<body>
  <%- include("/header") %>

  <!-- ── Bannière ──────────────────────────────────────── -->
  <div class="dashboard-banner">
    <div class="banner-inner">
      <div class="banner-text">
        <h1>Bonjour, <%= user.name %> 👋</h1>
        <p>Gérez vos réservations et retrouvez vos prestataires favoris</p>
      </div>
      <div class="banner-avatar">
        <%= user.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() %>
      </div>
    </div>
  </div>

  <div class="container">

    <!-- ── Stats ──────────────────────────────────────── -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-regular fa-calendar-check"></i></div>
        <div>
          <div class="stat-label">Réservations</div>
          <div class="stat-value"><%= reservations.length %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon red"><i class="fa-solid fa-heart"></i></div>
        <div>
          <div class="stat-label">Favoris</div>
          <div class="stat-value"><%= favorites.length %></div>
        </div>
      </div>
      <!-- <div class="stat-card">
        <div class="stat-icon green"><i class="fa-regular fa-comment-dots"></i></div>
        <div>
          <div class="stat-label">Messages</div>
          <div class="stat-value">5</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon yellow"><i class="fa-regular fa-bell"></i></div>
        <div>
          <div class="stat-label">Notifications</div>
          <div class="stat-value"><%= reservations.filter(function(r){ return r.status !== 'pending'; }).length %></div>
        </div>
      </div> -->
    </div>

    <!-- ── Contenu principal ──────────────────────────── -->
    <div class="main-content">
      <div class="left-col">

        <!-- Réservations -->
        <section class="section-card">
          <div class="section-header">
            <h2><i class="fa-regular fa-calendar-check" style="margin-right:6px;"></i>Mes réservations</h2>
            <a href="/recherche" class="btn-primary" style="text-decoration:none;">+ Nouvelle</a>
          </div>
          <% if (reservations.length === 0) { %>
            <div class="empty-state">
              <i class="fa-regular fa-calendar-xmark"></i>
              Aucune réservation pour le moment.
              <br><a href="/recherche" style="color:var(--accent);font-weight:700;margin-top:8px;display:inline-block;">Trouver un prestataire →</a>
            </div>
          <% } else { %>
            <% reservations.forEach(function(r) {
              var d = new Date(r.date);
              var isUpcoming = d > new Date();
              var dateStr = d.toLocaleDateString('fr-FR', {day:'2-digit', month:'2-digit', year:'numeric'});
              var timeStr = d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
            %>
              <div class="reservation-item">
                <div class="res-info">
                  <strong><%= r.category_name ?? 'Prestation' %></strong>
                  <span><%= r.provider_name %></span>
                  <small>
                    <i class="fa-regular fa-calendar"></i> <%= dateStr %>
                    &nbsp;
                    <i class="fa-regular fa-clock"></i> <%= timeStr %>
                    &nbsp;·&nbsp;
                    <i class="fa-solid fa-euro-sign"></i> <%= r.price %>€
                  </small>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
                  <% if (r.status === 'confirmed') { %>
                    <span class="status success"><i class="fa-solid fa-circle-check"></i> Confirmé</span>
                  <% } else if (r.status === 'rejected') { %>
                    <span class="status" style="background:#fff1f2;color:#e11d48;"><i class="fa-solid fa-circle-xmark"></i> Refusé</span>
                  <% } else if (isUpcoming) { %>
                    <span class="status warning"><i class="fa-regular fa-clock"></i> En attente</span>
                  <% } else { %>
                    <span class="status" style="background:#f1f5f9;color:#64748b;">Terminé</span>
                  <% } %>
                  <a href="/profile/providers/<%= r.provider_id %>" style="font-size:0.72rem;color:var(--accent);text-decoration:none;font-weight:700;">Voir profil →</a>
                </div>
              </div>
            <% }) %>
          <% } %>
        </section>

        <!-- Favoris -->
        <section class="section-card">
          <div class="section-header">
            <h2><i class="fa-solid fa-heart" style="margin-right:6px;"></i>Prestataires favoris</h2>
          </div>
          <% if (favorites.length === 0) { %>
            <div class="empty-state">
              <i class="fa-regular fa-heart"></i>
              Aucun favori pour le moment.<br>
              <a href="/recherche" style="color:var(--accent);font-weight:700;margin-top:8px;display:inline-block;">Trouver un prestataire →</a>
            </div>
          <% } else { %>
            <div class="fav-grid">
              <% favorites.forEach(function(f) { %>
                <a href="/profile/providers/<%= f.provider_id %>" class="fav-item">
                  <div class="fav-avatar">
                    <%= f.provider_name.split(' ').map(function(n){ return n[0]; }).join('').slice(0,2).toUpperCase() %>
                  </div>
                  <%= f.provider_name %>
                  <span class="heart"><i class="fa-solid fa-heart"></i></span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </section>

      </div>

      <!-- ── Sidebar ──────────────────────────────────── -->
      <aside class="sidebar">

        <div class="section-card profile-card">
          <div class="profile-avatar">
            <%= user.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() %>
          </div>
          <h3><%= user.name %></h3>
          <p><%= user.email %></p>
          <button class="btn-outline">
            <i class="fa-regular fa-pen-to-square"></i> Modifier le profil
          </button>
        </div>

        <div class="cta-card">
          <h3>Trouver un prestataire</h3>
          <p>Parcourez nos professionnels vérifiés près de chez vous</p>
          <a href="/recherche" class="btn-white">Explorer →</a>
        </div>

        <div class="section-card">
          <div class="section-header" style="margin-bottom:0; padding-bottom:0; border-bottom:none;">
            <h2><i class="fa-solid fa-bolt" style="margin-right:6px;"></i>Accès rapide</h2>
          </div>
          <ul style="list-style:none; margin-top:1rem;">
            <li style="padding:9px 0; border-bottom:1px solid var(--border); font-size:0.85rem;">
              <a href="/recherche" style="color:var(--text-main); text-decoration:none; display:flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-magnifying-glass" style="color:var(--accent); width:16px;"></i> Rechercher
              </a>
            </li>
            <li style="padding:9px 0; border-bottom:1px solid var(--border); font-size:0.85rem;">
              <a href="#" style="color:var(--text-main); text-decoration:none; display:flex; align-items:center; gap:8px;">
                <i class="fa-regular fa-calendar" style="color:var(--accent); width:16px;"></i> Mes réservations
              </a>
            </li>
            <li style="padding:9px 0; font-size:0.85rem;">
              <a href="/logout" style="color:#e11d48; text-decoration:none; display:flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-right-from-bracket" style="width:16px;"></i> Se déconnecter
              </a>
            </li>
          </ul>
        </div>

      </aside>
    </div>
  </div>

  <%- include("/footer") %>
</body>
</html>
