<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prestalia_Desktop.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Prestalia_Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="ShadowCastGrid"/>

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="24">

            <InfoBar
                Width="360"
                x:Name="ErrorInfoBar"
                IsOpen="False"
                Title="Connexion impossible"
                Severity="Error"/>

            <Border
                x:Name="ShadowRect"
                Translation="0,0,32"
                Loaded="ShadowRect_Loaded"
                Width="360"
                Padding="24"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <Border.Shadow>
                    <ThemeShadow x:Name="shadow"/>
                </Border.Shadow>

                <StackPanel Spacing="16">
                    <StackPanel Spacing="12">
                        <Image
                            Source="Assets/Gemini_Generated_Image.png"
                            Width="96"
                            Height="96"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Bienvenue"
                            Style="{StaticResource TitleTextBlockStyle}"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Connectez-vous à votre compte"
                            Style="{StaticResource BodyTextBlockStyle}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBox
                        x:Name="EmailTextBox"
                        Header="Email"
                        PlaceholderText="test@example.com"
                        IsSpellCheckEnabled="False"
                        />

                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Mot de passe"
                        PlaceholderText="Entrez votre mot de passe"/>

                    <Button
                        Content="Se connecter"
                        Click="LoginButton_Click"
                        HorizontalAlignment="Stretch"/>

                    <ProgressBar
                        x:Name="ProgressBar"
                        IsIndeterminate="True"
                        ShowPaused="False"
                        ShowError="False"
                        Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
