<Window
    x:Class="Prestalia_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Prestalia_Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Prestalia_Desktop">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Border
            Width="360"
            Padding="30"
            CornerRadius="20"
            Background="#AA1E1E1E"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="12">

                <!-- LOGO -->
                <Image Source="Assets/Gemini_Generated_Image.png"
                       Width="100"
                       Height="100"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

                <!-- TITRE -->
                <TextBlock Text="Bienvenue"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Connectez-vous à votre compte"
                           FontSize="12"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- EMAIL -->
                <TextBox x:Name="EmailTextBox"
                         PlaceholderText="Email"
                         Height="40"
                         CornerRadius="8"/>

                <!-- PASSWORD -->
                <PasswordBox x:Name="PasswordBox"
                             PlaceholderText="Mot de passe"
                             Height="40"
                             CornerRadius="8"/>

                <!-- BUTTON -->
                <Button Content="Se connecter"
                        Height="45"
                        Margin="0,10,0,0"
                        Click="LoginButton_Click"
                        Background="#0078D7"
                        Foreground="White"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        CornerRadius="10"/>

                <!-- RESULT -->
                <TextBlock x:Name="ResultText"
                           Foreground="LightGray"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>